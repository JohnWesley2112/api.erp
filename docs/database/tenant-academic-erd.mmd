erDiagram
    academic_years {
        String id PK
        String name UK
        DateTime start_date
        DateTime end_date
        AcademicYearStatus status
        DateTime created_at
        DateTime updated_at
    }
    classes {
        String id PK
        String name
        String code UK
        Int display_order
        ClassStatus status
        DateTime created_at
        DateTime updated_at
    }
    sections {
        String id PK
        String academic_year_id FK
        String class_id FK
        String name
        SectionStatus status
        DateTime created_at
        DateTime updated_at
    }
    subjects {
        String id PK
        String name
        String code UK
        SubjectStatus status
        DateTime created_at
        DateTime updated_at
    }
    teachers {
        String id PK
        String user_id UK
        String employee_code UK
        String first_name
        String last_name
        TeacherStatus status
        DateTime created_at
        DateTime updated_at
    }
    teacher_assignments {
        String id PK
        String teacher_id FK
        String subject_id FK
        String section_id FK
        DateTime created_at
    }

    academic_years ||--o{ sections : "academic_year_id"
    classes ||--o{ sections : "class_id"
    teachers ||--o{ teacher_assignments : "teacher_id"
    subjects ||--o{ teacher_assignments : "subject_id"
    sections ||--o{ teacher_assignments : "section_id"

