generator client {
    provider = "prisma-client-js"
    output   = "../node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model users {
    user_id        Int       @id @default(autoincrement())
    user_firstname String?   @db.VarChar(50)
    user_lastname  String?   @db.VarChar(50)
    user_email     String?   @unique(map: "unique_user_email") @db.VarChar(50)
    hsd_pwd        String?   @db.VarChar(100)
    created_at     DateTime? @default(now()) @db.Timestamp(6)
    role_id        Int?
    roles          roles?    @relation(fields: [role_id], references: [id], onUpdate: NoAction, map: "fk_role")
}

model roles {
    id        Int     @id @default(autoincrement())
    role_name String  @unique @db.VarChar(50)
    users     users[]
}
