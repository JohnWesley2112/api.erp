{
    "name": "api.erp",
    "version": "1.0.0",
    "type": "module",
    "description": "this is a hobby erp server application",
    "main": "dist/server.js",
    "author": "John Wesley",
    "license": "ISC",
    "scripts": {
        "predev": "npx prisma generate --schema prisma/admin/schema.prisma && npx prisma generate --schema prisma/tenant/schema.prisma",
        "dev": "nodemon --exec tsx src/server.ts",
        "prebuild": "npx prisma generate --schema prisma/admin/schema.prisma && npx prisma generate --schema prisma/tenant/schema.prisma",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "prisma:validate:admin": "npx prisma validate --schema prisma/admin/schema.prisma",
        "prisma:validate:tenant": "npx prisma validate --schema prisma/tenant/schema.prisma",
        "prisma:generate:admin": "npx prisma generate --schema prisma/admin/schema.prisma",
        "prisma:generate:tenant": "npx prisma generate --schema prisma/tenant/schema.prisma",
        "prisma:seed": "npx prisma generate --schema prisma/tenant/schema.prisma && tsx prisma/tenant/seed.ts",
        "prisma:seed:admin": "npx prisma generate --schema prisma/admin/schema.prisma && tsx prisma/admin/seed.ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "crypto": "^1.0.1",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "loggerverse": "^1.0.15",
        "prisma": "^6.19.3",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.7.0",
        "@types/supertest": "^7.2.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^10.11.0",
        "globals": "^17.12.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.8",
        "supertest": "^7.2.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.70.0",
        "vitest": "^5.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/JohnWesley2112/web.api.git"
    },
    "bugs": {
        "url": "https://github.com/JohnWesley2112/web.api/issues"
    },
    "homepage": "https://github.com/JohnWesley2112/web.api#readme"
}